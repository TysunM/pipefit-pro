{
  "expo": {
    "name": "PipeFit Pro",
    "slug": "pipefit-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pipefitpro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pipefitpro.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.pipefitpro.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": { "backgroundColor": "#121A1F" }
        }
      ]
    ]
  }
}
