{
  "expo": {
    "name": "PipeFit Pro",
    "slug": "pipefit-pro",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "pipefitpro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/08b3fb2e-3d53-45ce-a0af-8715db2eb125",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pipefitpro.app",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.pipefitpro.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A4FBE"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#0F1318"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "08b3fb2e-3d53-45ce-a0af-8715db2eb125"
      }
    }
  }
}
